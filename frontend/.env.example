# API Configuration
# In development: leave VITE_API_URL empty to use Vite proxy
# In Docker/production: set to http://backend:5000 or your backend URL
VITE_API_URL=
VITE_SOCKET_URL=http://localhost:5000

# Google Maps API (for map display + Places Autocomplete)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeatherMap API (for Weather Forecasts)
# Sign up for free at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here