# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/tripwhat

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# OpenTripMap API (Free tier: https://opentripmap.io/product)
OPENTRIPMAP_API_KEY=your_api_key_here

# SerpApi (Google Flights + Google Hotels) - https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key_here
INVENTORY_PROVIDER=serpapi

# Google Places API (Optional - $200 free credit)
GOOGLE_PLACES_API_KEY=your_google_places_key_here

# OpenWeatherMap API (Free tier)
OPENWEATHER_API_KEY=your_openweather_key_here

# Geoapify (Free tier - 3K requests/day)
GEOAPIFY_API_KEY=your_geoapify_key_here

# JWT Secret (generate a random string)
JWT_SECRET=your_jwt_secret_here

#JWT token expiry time
JWT_EXPIRES_IN=""

# CORS
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback