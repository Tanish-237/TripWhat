# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tripwhat

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# OpenTripMap API
OPENTRIPMAP_API_KEY=your_api_key_here

# SerpApi (Google Flights + Google Hotels)
SERPAPI_API_KEY=your_serpapi_key_here

# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_key_here

# GeoDB (autocomplete)
GEODB_API_KEY=your_geodb_key_here
GEODB_HOST=wft-geo-db.p.rapidapi.com

# JWT
JWT_SECRET=your_jwt_secret_here

# CORS
FRONTEND_URL=http://localhost:5173

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
